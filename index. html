<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RésaPro — Prestations & Rendez-vous</title>
  <style>
    :root {
      --primary: #2563eb;
      --primary-hover: #1d4ed8;
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      margin: 0;
      padding: 20px;
      line-height: 1.5;
    }

    .container {
      max-width: 600px;
      margin: 0 auto;
    }

    header {
      text-align: center;
      margin-bottom: 30px;
    }

    h1 {
      color: var(--primary);
      margin-bottom: 5px;
    }

    .card {
      background: var(--card-bg);
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      margin-bottom: 20px;
    }

    .service-item {
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      transition: border-color 0.2s;
    }

    .service-item:hover {
      border-color: var(--primary);
    }

    .service-info h3 {
      margin: 0 0 4px 0;
      font-size: 1.1rem;
    }

    .service-info p {
      margin: 0;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .price-tag {
      font-weight: bold;
      color: var(--primary);
      font-size: 1.1rem;
      display: block;
      margin-bottom: 8px;
    }

    button {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.2s;
      width: 100%;
      font-size: 1rem;
    }

    button:hover {
      background-color: var(--primary-hover);
    }

    .form-group {
      margin-bottom: 16px;
    }

    label {
      display: block;
      margin-bottom: 6px;
      font-weight: 500;
      font-size: 0.9rem;
    }

    input[type="text"],
    input[type="tel"] {
      width: 100%;
      padding: 12px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      box-sizing: border-box;
      font-size: 1rem;
    }

    input:focus {
      outline: none;
      border-color: var(--primary);
      ring: 2px solid rgba(37, 99, 235, 0.2);
    }

    .summary-box {
      background-color: #eff6ff;
      border-left: 4px solid var(--primary);
      padding: 16px;
      margin-bottom: 20px;
      border-radius: 0 8px 8px 0;
    }

    .summary-box p {
      margin: 4px 0;
    }

    .instructions {
      background-color: #fef3c7;
      border: 1px solid #f59e0b;
      padding: 16px;
      border-radius: 8px;
      margin-top: 20px;
    }

    .instructions h4 {
      margin: 0 0 8px 0;
      color: #92400e;
    }

    .instructions ol {
      margin: 0;
      padding-left: 20px;
      font-size: 0.9rem;
    }

    .hidden {
      display: none;
    }
  </style>
</head>
<body>

<div class="container">
  <header>
    <h1>RésaPro</h1>
    <p>Réservez votre prestation en quelques clics</p>
  </header>

  <div id="catalog-section" class="card">
    <h2>Nos Prestations</h2>
    <div id="services-list"></div>
  </div>

  <div id="booking-section" class="card hidden">
    <h2>Finaliser la réservation</h2>
    <div class="summary-box">
      <p>Prestation : <strong id="summary-service-name"></strong></p>
      <p>Prix total : <span id="summary-total-price"></span> FCFA</p>
      <p><strong>Acompte à régler (30%) : <span id="summary-deposit-price"></span> FCFA</strong></p>
    </div>

    <div class="form-group">
      <label for="client-name">Votre Nom complet</label>
      <input type="text" id="client-name" placeholder="Ex: Jean Koné" required>
    </div>

    <div class="form-group">
      <label for="client-phone">Votre Numéro Mobile Money</label>
      <input type="tel" id="client-phone" placeholder="Ex: 0700000000" required>
    </div>

    <button id="submit-btn" onclick="validateBooking()">Valider et Afficher les instructions</button>
  </div>

  <div id="instructions-section" class="instructions hidden">
    <h4>Instructions de paiement manuel</h4>
    <p>Pour confirmer votre rendez-vous, veuillez effectuer le transfert de l'acompte.</p>
    <ol>
      <li>Rendez-vous sur le menu de votre opérateur (MTN Momo ou Moov Money).</li>
      <li>Choisissez "Envoyer de l'argent".</li>
      <li>Entrez le numéro marchand : <strong>+229 97 00 00 00</strong>.</li>
      <li>Indiquez le montant : <strong id="instruction-deposit-amount"></strong> FCFA.</li>
      <li>Validez avec votre code secret et conservez l'identifiant de la transaction.</li>
    </ol>
    <p style="margin-top: 15px; font-size: 0.85rem; color: var(--text-muted);">
      <em>Une fois le transfert effectué, nous vérifierons la réception et vous enverrons un SMS de confirmation.</em>
    </p>
    <button onclick="resetApp()" style="background-color: var(--text-muted); margin-top: 15px;">Faire une autre réservation</button>
  </div>
</div>

<script>
  // Configuration des services
  const services = [
    { id: 1, name: "Coiffure Tresses Premium", price: 10000, duration: "2h" },
    { id: 2, name: "Soin Visage Éclat", price: 15000, duration: "1h30" },
    { id: 3, name: "Consultation Business", price: 25000, duration: "1h" }
  ];

  let selectedService = null;

  // Initialisation de la page
  function init() {
    const listElement = document.getElementById('services-list');
    listElement.innerHTML = services.map(service => `
      <div class="service-item">
        <div class="service-info">
          <h3>${service.name}</h3>
          <p>Durée estimée : ${service.duration}</p>
        </div>
        <div>
          <span class="price-tag">${service.price.toLocaleString()} FCFA</span>
          <button onclick="selectService(${service.id})">Choisir</button>
        </div>
      </div>
    `).join('');
  }

  // Sélection d'un service
  function selectService(serviceId) {
    selectedService = services.find(s => s.id === serviceId);
    if (!selectedService) return;

    const deposit = selectedService.price * 0.3; // Calcul de l'acompte (30%)

    document.getElementById('summary-service-name').innerText = selectedService.name;
    document.getElementById('summary-total-price').innerText = selectedService.price.toLocaleString();
    document.getElementById('summary-deposit-price').innerText = deposit.toLocaleString();
    document.getElementById('instruction-deposit-amount').innerText = deposit.toLocaleString();

    document.getElementById('catalog-section').classList.add('hidden');
    document.getElementById('booking-section').classList.remove('hidden');
    document.getElementById('instructions-section').classList.add('hidden');
  }

  // Validation du formulaire
  function validateBooking() {
    const name = document.getElementById('client-name').value.trim();
    const phone = document.getElementById('client-phone').value.trim();

    if (!name || !phone) {
      alert("Veuillez remplir tous les champs pour continuer.");
      return;
    }

    // Affichage des instructions
    document.getElementById('booking-section').classList.add('hidden');
    document.getElementById('instructions-section').classList.remove('hidden');
  }

  // Réinitialisation de l'application
  function resetApp() {
    selectedService = null;
    document.getElementById('client-name').value = '';
    document.getElementById('client-phone').value = '';
    
    document.getElementById('instructions-section').classList.add('hidden');
    document.getElementById('catalog-section').classList.remove('hidden');
  }

  // Lancer l'application au chargement
  init();
</script>

</body>
</html>
